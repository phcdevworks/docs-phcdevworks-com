---
import DocsLayout from "../layouts/DocsLayout.astro"
import { SpCard, SpButton } from "@phcdevworks/spectre-ui-astro"
---

<DocsLayout title="Spectre Documentation">
  <p class="lead">
    The official documentation for Spectre — the PHCDevworks design system.
    Find implementation guides, component references, and integration
    documentation for the Spectre ecosystem here.
  </p>

  <div class="grid">
    <SpCard variant="outline">
      <h3>Quick Start</h3>
      <p>Get up and running with the Spectre ecosystem in minutes.</p>
      <SpButton variant="secondary" size="sm" class="mt-4">Read Guide</SpButton>
    </SpCard>

    <SpCard variant="outline">
      <h3>Component Reference</h3>
      <p>Detailed documentation for Spectre UI components and design tokens.</p>
      <SpButton variant="secondary" size="sm" as="a" href="/design" class="mt-4">Explore Reference</SpButton>
    </SpCard>
  </div>

  <h2>About Spectre</h2>
  <p>
    Spectre is the PHCDevworks design system. It provides design tokens, UI
    components, framework adapters, and supporting tooling for building
    consistent, maintainable web products across the PHCDevworks ecosystem.
  </p>

  <style>
    .lead {
      font-size: 1.25rem;
      color: #475569;
      margin-bottom: 3rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      margin-bottom: 4rem;
    }

    .grid h3 {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .mt-4 {
      margin-top: 1rem;
    }
  </style>
</DocsLayout>
