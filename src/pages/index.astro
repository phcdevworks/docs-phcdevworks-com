---
import { getCollection } from 'astro:content'
import {
  SpAlert,
  SpButton,
  SpCard,
  SpGrid,
  SpStack
} from '@phcdevworks/spectre-ui-astro'
import DocsLayout from '../layouts/DocsLayout.astro'

const packageEntries = await getCollection('docs', (entry) =>
  entry.id.startsWith('packages/')
)

const packages = packageEntries
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    href: `/${entry.id}`
  }))
  .sort((a, b) => a.title.localeCompare(b.title))
---

<DocsLayout
  title="Spectre Documentation"
  description="The official reference for the Spectre design system — tokens, UI, Astro components, web components, and the WordPress theme shell."
>
  <SpAlert variant="info" size="sm">
    Early Access — documentation is actively expanding. All packages are
    covered.
  </SpAlert>

  <SpGrid columns={3} gap="md" as="div">
    {
      packages.map((pkg) => (
        <SpCard variant="elevated" padded fullHeight>
          <SpStack as="div">
            <h3>{pkg.title}</h3>
            <p>{pkg.description}</p>
            <SpButton variant="primary" size="sm" as="a" href={pkg.href}>
              Overview
            </SpButton>
          </SpStack>
        </SpCard>
      ))
    }
  </SpGrid>
</DocsLayout>
