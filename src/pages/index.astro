---
import {
  SpAlert,
  SpBadge,
  SpButton,
  SpCard
} from '@phcdevworks/spectre-ui-astro'
import DocsLayout from '../layouts/DocsLayout.astro'
---

<DocsLayout
  title="Spectre Documentation"
  description="The official reference for the Spectre design system — tokens, UI, Astro components, web components, and the WordPress theme shell."
  fullWidth
>
  <SpAlert variant="info" size="sm">
    Early Access — documentation is actively expanding. All five packages are
    covered.
  </SpAlert>

  <div class="pkg-grid">
    <SpCard variant="elevated" padded fullHeight>
      <div class="pkg-card">
        <div class="pkg-card-top">
          <SpBadge variant="primary" size="sm">v2.9.0</SpBadge>
        </div>
        <h3 class="pkg-title">Spectre Tokens</h3>
        <p class="pkg-desc">
          Design-token contract — colors, spacing, typography, and semantic
          roles as CSS variables, JS/TS exports, and a Tailwind preset.
        </p>
        <div class="pkg-actions">
          <SpButton variant="primary" size="sm" as="a" href="/design/tokens"
            >Overview</SpButton
          >
          <SpButton
            variant="secondary"
            size="sm"
            as="a"
            href="/design/tokens-reference">Reference</SpButton
          >
        </div>
      </div>
    </SpCard>

    <SpCard variant="elevated" padded fullHeight>
      <div class="pkg-card">
        <div class="pkg-card-top">
          <SpBadge variant="primary" size="sm">v1.9.0</SpBadge>
        </div>
        <h3 class="pkg-title">Spectre UI</h3>
        <p class="pkg-desc">
          Precompiled CSS bundles, Tailwind helpers, and type-safe class recipes
          for 17 UI patterns — buttons, cards, inputs, badges, and more.
        </p>
        <div class="pkg-actions">
          <SpButton variant="primary" size="sm" as="a" href="/design/ui"
            >Overview</SpButton
          >
          <SpButton
            variant="secondary"
            size="sm"
            as="a"
            href="/design/ui-reference">Reference</SpButton
          >
        </div>
      </div>
    </SpCard>

    <SpCard variant="elevated" padded fullHeight>
      <div class="pkg-card">
        <div class="pkg-card-top">
          <SpBadge variant="primary" size="sm">v2.7.0</SpBadge>
        </div>
        <h3 class="pkg-title">Spectre UI Astro</h3>
        <p class="pkg-desc">
          17 SSR-safe Astro components with typed props, named slots, and
          polymorphic rendering. SpButton, SpCard, SpInput, SpModal, SpNav, and
          more.
        </p>
        <div class="pkg-actions">
          <SpButton variant="primary" size="sm" as="a" href="/design/ui-astro"
            >Overview</SpButton
          >
          <SpButton
            variant="secondary"
            size="sm"
            as="a"
            href="/design/ui-astro-reference">Components</SpButton
          >
        </div>
      </div>
    </SpCard>

    <SpCard variant="elevated" padded fullHeight>
      <div class="pkg-card">
        <div class="pkg-card-top">
          <SpBadge variant="primary" size="sm">v1.5.0</SpBadge>
        </div>
        <h3 class="pkg-title">Spectre Components</h3>
        <p class="pkg-desc">
          18 Lit custom elements — light-DOM, ARIA-forwarding,
          framework-agnostic. Works in React, Vue, Astro, and plain HTML.
        </p>
        <div class="pkg-actions">
          <SpButton variant="primary" size="sm" as="a" href="/design/components"
            >Overview</SpButton
          >
          <SpButton
            variant="secondary"
            size="sm"
            as="a"
            href="/design/components-reference">Reference</SpButton
          >
        </div>
      </div>
    </SpCard>

    <SpCard variant="elevated" padded fullHeight>
      <div class="pkg-card">
        <div class="pkg-card-top">
          <SpBadge variant="primary" size="sm">v1.0.0</SpBadge>
        </div>
        <h3 class="pkg-title">Spectre Base</h3>
        <p class="pkg-desc">
          WordPress theme shell with a Vite + TypeScript build pipeline.
          Delivers tokens, UI, and web components to WordPress sites.
        </p>
        <div class="pkg-actions">
          <SpButton variant="primary" size="sm" as="a" href="/design/base"
            >Overview</SpButton
          >
          <SpButton
            variant="secondary"
            size="sm"
            as="a"
            href="/design/base-reference">Reference</SpButton
          >
        </div>
      </div>
    </SpCard>

    <SpCard
      variant="outline"
      padded
      interactive
      as="a"
      href="/design"
      aria-label="Design system overview"
    >
      <div class="pkg-card pkg-card--overview">
        <h3 class="pkg-title">Design System Overview</h3>
        <p class="pkg-desc">
          How the five layers fit together — architecture diagram, dependency
          chain, and where to start.
        </p>
      </div>
    </SpCard>
  </div>
</DocsLayout>
