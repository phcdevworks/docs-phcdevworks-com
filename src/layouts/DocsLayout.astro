---
import '@phcdevworks/spectre-tokens/index.css'
import '@phcdevworks/spectre-ui/index.css'
import { ClientRouter } from 'astro:transitions'
import { SpNav, SpBadge, SpIconBox } from '@phcdevworks/spectre-ui-astro'
import { getNavLinksClasses, getNavLinkClasses } from '@phcdevworks/spectre-ui'

interface Props {
  title: string
  description?: string
  frontmatter?: Record<string, unknown>
  fullWidth?: boolean
}

const { title, description, frontmatter, fullWidth = false } = Astro.props

const metaTitle =
  typeof frontmatter?.title === 'string' ? frontmatter.title : title
const metaDesc =
  typeof frontmatter?.description === 'string'
    ? frontmatter.description
    : (description ?? 'PHCDevworks documentation portal.')

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const active = (href: string) => (href.replace(/\/$/, '') || '/') === path

const navLinks = getNavLinksClasses()
const navLink = getNavLinkClasses()
const navLinkActive = getNavLinkClasses({ active: true })

const packages = [
  { href: '/design/tokens', ref: '/design/tokens-reference', label: 'Tokens' },
  { href: '/design/ui', ref: '/design/ui-reference', label: 'UI' },
  {
    href: '/design/ui-astro',
    ref: '/design/ui-astro-reference',
    label: 'UI Astro'
  },
  {
    href: '/design/components',
    ref: '/design/components-reference',
    label: 'Components'
  },
  { href: '/design/base', ref: '/design/base-reference', label: 'Base' }
] as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle} | PHCDevworks Docs</title>
    <meta name="description" content={metaDesc} />
    <script is:inline>
      ;(function () {
        var dark = window.matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.setAttribute(
          'data-spectre-theme',
          dark ? 'dark' : 'light'
        )
        window
          .matchMedia('(prefers-color-scheme: dark)')
          .addEventListener('change', function (e) {
            document.documentElement.setAttribute(
              'data-spectre-theme',
              e.matches ? 'dark' : 'light'
            )
          })
      })()
    </script>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <SpNav bordered sticky fullWidth aria-label="Site navigation">
      <div class={navLinks}>
        <a href="/" class="docs-brand" aria-label="PHCDevworks Docs home">
          <SpIconBox variant="primary" size="sm" pill>
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                d="M4 18V4a2 2 0 0 1 2-2h9l3 3v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Zm7-11V2.5L17.5 9H11Z"
              ></path>
            </svg>
          </SpIconBox>
          <span class="docs-brand-text">Spectre Docs</span>
        </a>
        <a href="/design" class={active('/design') ? navLinkActive : navLink}
          >Design System</a
        >
      </div>
      <div class="docs-nav-end">
        <SpBadge variant="neutral" size="sm">Early Access</SpBadge>
      </div>
    </SpNav>

    <div class="docs-layout">
      <aside class="docs-sidebar" aria-label="Documentation navigation">
        <div class="docs-sidebar-section">
          <span class="docs-sidebar-heading">Getting Started</span>
          <nav>
            <a
              href="/"
              class:list={[
                'docs-nav-item',
                { 'docs-nav-item--active': active('/') }
              ]}
            >
              Introduction
            </a>
          </nav>
        </div>

        <div class="docs-sidebar-section">
          <span class="docs-sidebar-heading">Design System</span>
          <nav>
            <a
              href="/design"
              class:list={[
                'docs-nav-item',
                { 'docs-nav-item--active': active('/design') }
              ]}
            >
              Overview
            </a>
            {
              packages.map((pkg) => (
                <div class="docs-nav-group">
                  <a
                    href={pkg.href}
                    class:list={[
                      'docs-nav-item',
                      { 'docs-nav-item--active': active(pkg.href) }
                    ]}
                  >
                    {pkg.label}
                  </a>
                  <a
                    href={pkg.ref}
                    class:list={[
                      'docs-nav-subitem',
                      { 'docs-nav-subitem--active': active(pkg.ref) }
                    ]}
                  >
                    Reference
                  </a>
                </div>
              ))
            }
          </nav>
        </div>
      </aside>

      <main class="docs-content">
        <div class:list={['docs-prose', { 'docs-prose--full': fullWidth }]}>
          <h1 class="docs-page-title">{metaTitle}</h1>
          {
            metaDesc && metaDesc !== 'PHCDevworks documentation portal.' && (
              <p class="docs-page-lead">{metaDesc}</p>
            )
          }
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
