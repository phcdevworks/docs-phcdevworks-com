---
import '@phcdevworks/spectre-tokens/index.css'
import '@phcdevworks/spectre-ui/index.css'
import { ClientRouter } from 'astro:transitions'
import {
  SpNav,
  SpSidebar,
  SpSidebarToggle,
  SpIconBox,
  SpContainer,
  SpStack,
  SpSection
} from '@phcdevworks/spectre-ui-astro'
import {
  getNavLinksClasses,
  getNavLinkClasses,
  getSidebarLinkClasses,
  getSidebarHeaderClasses
} from '@phcdevworks/spectre-ui'

interface Props {
  title: string
  description?: string
  frontmatter?: Record<string, unknown>
}

const { title, description, frontmatter } = Astro.props

const metaTitle =
  typeof frontmatter?.title === 'string' ? frontmatter.title : title
const metaDesc =
  typeof frontmatter?.description === 'string'
    ? frontmatter.description
    : (description ?? 'PHCDevworks documentation portal.')

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const active = (href: string) => (href.replace(/\/$/, '') || '/') === path

const navLinks = getNavLinksClasses()
const navLink = getNavLinkClasses()
const navLinkActive = getNavLinkClasses({ active: true })
const sidebarLink = getSidebarLinkClasses()
const sidebarLinkActive = getSidebarLinkClasses({ active: true })
const sidebarHeader = getSidebarHeaderClasses()

const packages = [
  { href: '/design/tokens', ref: '/design/tokens-reference', label: 'Tokens' },
  { href: '/design/ui', ref: '/design/ui-reference', label: 'UI' },
  {
    href: '/design/ui-astro',
    ref: '/design/ui-astro-reference',
    label: 'UI Astro'
  },
  {
    href: '/design/components',
    ref: '/design/components-reference',
    label: 'Components'
  },
  { href: '/design/base', ref: '/design/base-reference', label: 'Base' }
] as const

const generatedPackages = [
  { area: 'project-design', label: 'Design System', repos: [
    { href: '/packages/spectre-tokens', label: 'Spectre Tokens' },
    { href: '/packages/spectre-ui', label: 'Spectre UI' },
    { href: '/packages/spectre-ui-astro', label: 'Spectre UI Astro' },
    { href: '/packages/spectre-components', label: 'Spectre Components' },
    { href: '/packages/spectre-base', label: 'Spectre Base' }
  ] },
  { area: 'project-shell', label: 'App Shell', repos: [
    { href: '/packages/spectre-shell', label: 'Spectre Shell' },
    { href: '/packages/spectre-shell-router', label: 'Spectre Shell Router' },
    { href: '/packages/spectre-shell-signals', label: 'Spectre Shell Signals' },
    { href: '/packages/spectre-init', label: 'Spectre Init' },
    { href: '/packages/spectre-manifest', label: 'Spectre Manifest' }
  ] },
  { area: 'project-plugins', label: 'Plugins', repos: [
    { href: '/packages/spectre-icons', label: 'Spectre Icons' }
  ] }
] as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle} | PHCDevworks Docs</title>
    <meta name="description" content={metaDesc} />
    <script is:inline>
      ;(function () {
        function applyTheme() {
          var dark = window.matchMedia('(prefers-color-scheme: dark)').matches
          document.documentElement.setAttribute(
            'data-spectre-theme',
            dark ? 'dark' : 'light'
          )
        }
        applyTheme()
        document.addEventListener('astro:after-swap', applyTheme)
        window
          .matchMedia('(prefers-color-scheme: dark)')
          .addEventListener('change', function (e) {
            document.documentElement.setAttribute(
              'data-spectre-theme',
              e.matches ? 'dark' : 'light'
            )
          })
      })()
    </script>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <SpNav bordered sticky fullWidth aria-label="Site navigation">
      <div class={navLinks}>
        <SpSidebarToggle for="docs-sidebar" label="Toggle documentation menu" />
        <a href="/" aria-label="PHCDevworks Docs home">
          <SpStack direction="horizontal" as="div">
            <SpIconBox variant="primary" size="sm" pill>
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  d="M4 18V4a2 2 0 0 1 2-2h9l3 3v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Zm7-11V2.5L17.5 9H11Z"
                ></path>
              </svg>
            </SpIconBox>
            <span>Spectre Docs</span>
          </SpStack>
        </a>
        <a href="/design" class={active('/design') ? navLinkActive : navLink}
          >Design System</a
        >
      </div>
    </SpNav>

    <SpStack direction="horizontal" align="stretch" as="div">
      <SpStack basis="sidebar" as="div">
        <SpSidebar
          id="docs-sidebar"
          hideToggle
          bordered
          aria-label="Documentation navigation">
          <SpStack as="div">
            <span class={sidebarHeader}>Getting Started</span>
            <nav>
              <a href="/" class={active('/') ? sidebarLinkActive : sidebarLink}>
                Introduction
              </a>
            </nav>
          </SpStack>

          <SpStack as="div">
            <span class={sidebarHeader}>Design System</span>
            <nav>
              <a
                href="/design"
                class={active('/design') ? sidebarLinkActive : sidebarLink}
              >
                Overview
              </a>
            </nav>
          </SpStack>

          <SpStack as="div">
            <span class={sidebarHeader}>Guides</span>
            <nav>
              <SpStack as="div">
                <a
                  href="/guides/token-usage"
                  class={
                    active('/guides/token-usage')
                      ? sidebarLinkActive
                      : sidebarLink
                  }
                >
                  Token Usage
                </a>
                <a
                  href="/guides/component-usage"
                  class={
                    active('/guides/component-usage')
                      ? sidebarLinkActive
                      : sidebarLink
                  }
                >
                  Component Usage
                </a>
                <a
                  href="/guides/contributing-content"
                  class={
                    active('/guides/contributing-content')
                      ? sidebarLinkActive
                      : sidebarLink
                  }
                >
                  Contributing Content
                </a>
              </SpStack>
            </nav>
          </SpStack>

          {
            packages.map((pkg) => (
              <SpStack as="div">
                <span class={sidebarHeader}>{pkg.label}</span>
                <nav>
                  <SpStack as="div">
                    <a
                      href={pkg.href}
                      class={
                        active(pkg.href) ? sidebarLinkActive : sidebarLink
                      }
                    >
                      Overview
                    </a>
                    <a
                      href={pkg.ref}
                      class={active(pkg.ref) ? sidebarLinkActive : sidebarLink}
                    >
                      Reference
                    </a>
                  </SpStack>
                </nav>
              </SpStack>
            ))
          }

          {
            generatedPackages.map((group) => (
              <SpStack as="div">
                <span class={sidebarHeader}>{group.label}</span>
                <nav>
                  <SpStack as="div">
                    {group.repos.map((repo) => (
                      <a
                        href={repo.href}
                        class={active(repo.href) ? sidebarLinkActive : sidebarLink}
                      >
                        {repo.label}
                      </a>
                    ))}
                  </SpStack>
                </nav>
              </SpStack>
            ))
          }
        </SpSidebar>
      </SpStack>

      <SpContainer as="div">
        <SpSection as="main">
          <SpStack as="div">
            <h1>{metaTitle}</h1>
            {
              metaDesc && metaDesc !== 'PHCDevworks documentation portal.' && (
                <p>{metaDesc}</p>
              )
            }
            <slot />
          </SpStack>
        </SpSection>
      </SpContainer>
    </SpStack>
  </body>
</html>
